# Protects all /api/* routes (except /api/health).
# If unset, the server starts in demo mode with no auth required.
AGENTCLINIC_API_KEY=your-clinic-api-key-here

# Used by the Anthropic SDK for LLM triage and prescription calls.
# If unset, triage and prescribe endpoints return deterministic stub responses
# so the full visit flow can be demonstrated without a real API key.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
